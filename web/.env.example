GOOGLE_CLIENT_ID=paste-from-credentials.json
GOOGLE_CLIENT_SECRET=paste-from-credentials.json
SESSION_SECRET=change-me-for-local-dev
PORT=3001

# OAuth callback URL — defaults to localhost for dev.
# In production set to: https://YOUR_CLOUD_RUN_URL/auth/callback
# OAUTH_CALLBACK_URL=https://your-service.run.app/auth/callback

# In dev, set to the Vite origin so OAuth redirects land on the React app.
# In production, omit (defaults to '/' — NestJS serves the React bundle).
FRONTEND_URL=http://localhost:6173

# For Android/device testing on LAN: set both to your machine's local IP.
# FRONTEND_URL=http://192.168.x.x:6173
# CORS_ORIGIN=http://192.168.x.x:6173
